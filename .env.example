# Firebase web app configuration, from Project settings → Your apps → Web app.
# Leave these unset to run the studio as a local demo workspace with no backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the app at the local Firebase emulator suite instead of the live project.
VITE_FIREBASE_EMULATORS=false
