# The whole web app configuration for bessstudio-e55e1 is committed in
# src/platform/firebaseConfig.ts, so nothing here is required: a clean checkout builds and
# deploys as it stands.
#
# Google Analytics is off unless it is asked for. It loads a tracking script and sets cookies, so
# switching it on is a decision about what the site does to its visitors; consent handling belongs
# with it.
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Point the app at the local emulator suite instead of the live project.
NEXT_PUBLIC_FIREBASE_EMULATORS=false

# Only needed to point a build at a different project — staging, or a customer's own tenant.
# An empty API key runs the studio as a local demo workspace with no backend.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
