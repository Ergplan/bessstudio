# Firebase web app configuration, from the console:
#   Project settings → General → Your apps → Web app → SDK setup and configuration → Config
#
# Project bessstudio-e55e1 serves at
#   https://bessstudio-e55e1.web.app
#   https://bessstudio-e55e1.firebaseapp.com
#
# Copy this file to .env and fill in the two values only the console can give you:
# the API key and the app ID. Neither is a secret — a Firebase web API key identifies
# the project, and the Firestore rules are what protect the data — but .env stays
# out of the repository so each environment can point at its own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bessstudio-e55e1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bessstudio-e55e1
VITE_FIREBASE_STORAGE_BUCKET=bessstudio-e55e1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave the API key empty to run the studio as a local demo workspace with no backend.
# Set this to true to point the app at the local emulator suite instead of the live project.
VITE_FIREBASE_EMULATORS=false
