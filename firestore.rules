rules_version = '2';

// Every customer, project, quotation and activity entry lives under one organization document.
// Authorisation is therefore a single question on every path: is the caller a member of that
// organization, and does the member's role permit the write?
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberDoc(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)); }
    function isMember(orgId) { return signedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)); }
    function role(orgId) { return memberDoc(orgId).data.role; }
    function hasRole(orgId, allowed) { return isMember(orgId) && role(orgId) in allowed; }
    function canWrite(orgId) { return hasRole(orgId, ['owner', 'admin', 'approver', 'engineer', 'sales']); }
    function canManage(orgId) { return hasRole(orgId, ['owner', 'admin']); }
    // Staff see the whole workspace. The one external role, customer, sees only what it owns.
    function isStaff(orgId) { return hasRole(orgId, ['owner', 'admin', 'approver', 'engineer', 'sales', 'viewer']); }
    function isCustomer(orgId) { return hasRole(orgId, ['customer']); }
    function canApprove(orgId) { return hasRole(orgId, ['owner', 'admin', 'approver']); }
    // A price is the one thing here a stranger could act on, so it is not served to an address
    // nobody has proved they control. Mirrors canSeeFinancials() in the client.
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function ownsExisting() { return resource.data.ownerUid == request.auth.uid; }
    function ownsIncoming() { return request.resource.data.ownerUid == request.auth.uid; }
    function unchanged(field) { return request.resource.data[field] == resource.data[field]; }
    function orgDoc(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)); }
    function inviteDoc(orgId, token) { return get(/databases/$(database)/documents/organizations/$(orgId)/invites/$(token)); }
    /**
     * Whether this membership write is a valid acceptance of the invitation it names.
     *
     * The role must be the invited one, the address must be the invited one, and the invitation
     * must be unused, unrevoked and unexpired. Possession of the link alone is therefore not
     * enough — the signed-in address has to match it too.
     */
    function acceptingInvite(orgId) {
      return 'inviteToken' in request.resource.data
        && request.resource.data.inviteToken != null
        && exists(/databases/$(database)/documents/organizations/$(orgId)/invites/$(request.resource.data.inviteToken))
        && inviteDoc(orgId, request.resource.data.inviteToken).data.role == request.resource.data.role
        && inviteDoc(orgId, request.resource.data.inviteToken).data.email == request.auth.token.email
        && inviteDoc(orgId, request.resource.data.inviteToken).data.acceptedAt == null
        && inviteDoc(orgId, request.resource.data.inviteToken).data.revokedAt == null
        && request.time.toMillis() < inviteDoc(orgId, request.resource.data.inviteToken).data.expiresAtMs;
    }
    // A record may not be moved to a different tenant by writing a foreign orgId.
    function staysInOrg(orgId) { return !('orgId' in request.resource.data) || request.resource.data.orgId == orgId; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /organizations/{orgId} {
      // The first member is written in the same client session that creates the organization.
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // A signed-in visitor following an invitation or a registration link has to be able to see
      // which workspace it belongs to before deciding to join it.
      allow read: if isMember(orgId) || signedIn();
      allow update: if canManage(orgId);
      allow delete: if hasRole(orgId, ['owner']);

      match /members/{uid} {
        // A customer may read their own membership — that is how the client learns its role —
        // but not the supplier's staff list.
        allow read: if isStaff(orgId) || (signedIn() && request.auth.uid == uid);

        // Three ways a membership comes into being, and no fourth. None of them lets the caller
        // choose a role freely: an administrator names it, an invitation named it, or it is
        // `customer` in a workspace that has opened itself to the public.
        allow create: if canManage(orgId)
          // Bootstrap: the organization creator may add themselves as owner.
          || (signedIn() && request.auth.uid == uid
              && get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid)
          // Accepting an invitation. The token is in the membership being written, which is what
          // lets the rule find the invitation that authorises the role being claimed.
          || (signedIn() && request.auth.uid == uid && acceptingInvite(orgId))
          // Registering as a customer. Never any other role.
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.role == 'customer'
              && orgDoc(orgId).data.customerSignupEnabled == true);

        // A member may not promote themselves; role changes are an administrator's.
        allow update: if canManage(orgId)
          || (signedIn() && request.auth.uid == uid && unchanged('role'));
        allow delete: if canManage(orgId);
      }

      // Invitations. The document id is the token and the token is the credential, so a read is
      // allowed to anyone who can name one — guessing is what the 128 bits are for. Listing the
      // collection is a different matter and stays with administrators.
      match /invites/{token} {
        allow get: if signedIn();
        allow list: if canManage(orgId);
        allow create, delete: if canManage(orgId);
        // An administrator may change an invitation. The invited party may only burn it, and only
        // the one addressed to them.
        allow update: if canManage(orgId)
          || (signedIn()
              && resource.data.email == request.auth.token.email
              && request.resource.data.acceptedByUid == request.auth.uid
              && unchanged('role') && unchanged('email') && unchanged('expiresAtMs'));
      }

      match /settings/{docId} {
        // Settings carry the price book, so they stay inside the supplier.
        allow read: if isStaff(orgId);
        allow write: if canManage(orgId);
      }

      match /customers/{docId} {
        // The customer list is the supplier's pipeline; an external account never reads it.
        allow read: if isStaff(orgId);
        allow write: if canWrite(orgId) && staysInOrg(orgId);
      }

      match /projects/{docId} {
        allow read: if isStaff(orgId) || (isCustomer(orgId) && resource.data.ownerUid == request.auth.uid);
        allow create: if staysInOrg(orgId)
          && (canWrite(orgId) || (isCustomer(orgId) && ownsIncoming()));
        allow update: if staysInOrg(orgId)
          && (canWrite(orgId) || (isCustomer(orgId) && ownsExisting() && ownsIncoming()));
        allow delete: if canWrite(orgId) || (isCustomer(orgId) && ownsExisting());
      }

      match /quotes/{docId} {
        // A quotation carries a price, so reading one needs a verified address as well as the
        // right to see the record at all.
        allow read: if verified() && (isStaff(orgId) || (isCustomer(orgId) && ownsExisting()));

        // A customer may raise their own indicative estimate and submit it. They may not write a
        // formal quotation, approve anything, or record an approval.
        allow create: if staysInOrg(orgId) && verified() && (
          canWrite(orgId)
          || (isCustomer(orgId) && ownsIncoming()
              && request.resource.data.kind == 'indicative'
              && request.resource.data.status == 'draft'
              && request.resource.data.approvedByUid == null)
        );

        allow update: if staysInOrg(orgId) && verified() && (
          // Releasing a quotation is the approver's alone, and is the only way `approved` is set.
          (canApprove(orgId) && unchanged('ownerUid'))
          || (canWrite(orgId) && unchanged('ownerUid')
              && request.resource.data.status != 'approved'
              && unchanged('approvedByUid'))
          // The customer's own record: edit the draft, or submit it. Never beyond that.
          || (isCustomer(orgId) && ownsExisting() && ownsIncoming()
              && unchanged('approvedByUid')
              && resource.data.kind == 'indicative'
              && request.resource.data.kind == 'indicative'
              && resource.data.status in ['draft']
              && request.resource.data.status in ['draft', 'submitted'])
        );
        allow delete: if canManage(orgId) || (isCustomer(orgId) && ownsExisting() && resource.data.status == 'draft');
      }

      /**
       * Simulation scenarios. A learner's own workbench: staff see the workspace, a customer sees
       * the scenarios they own and nothing else. The same shape as projects, because a scenario is
       * the same kind of thing — something a person edits that belongs to them.
       */
      match /simScenarios/{docId} {
        allow read: if isStaff(orgId) || (isCustomer(orgId) && ownsExisting());
        allow create: if staysInOrg(orgId)
          && (canWrite(orgId) || (isCustomer(orgId) && ownsIncoming()));
        allow update: if staysInOrg(orgId)
          && (canWrite(orgId) || (isCustomer(orgId) && ownsExisting() && ownsIncoming()));
        allow delete: if canWrite(orgId) || (isCustomer(orgId) && ownsExisting());
      }

      /**
       * Simulation runs, and the results they produced.
       *
       * A run is a fact about the past: what was asked, what the model did, and what produced it.
       * It is written once and never edited, here rather than only in the client, because a result
       * that can be revised after the fact is not evidence of anything. A configuration that has
       * changed produces a new run; it does not overwrite the old one.
       */
      match /simRuns/{docId} {
        allow read: if isStaff(orgId) || (isCustomer(orgId) && ownsExisting());
        allow create: if staysInOrg(orgId)
          && (canWrite(orgId) || (isCustomer(orgId) && ownsIncoming()));
        allow update: if false;
        allow delete: if canManage(orgId) || (isCustomer(orgId) && ownsExisting());
      }

      match /activities/{docId} {
        allow read: if isStaff(orgId);
        // The audit trail is append-only: entries are never edited or removed from the client.
        allow create: if canWrite(orgId) && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
